#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DOTFILES_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
export DOTFILES_ROOT

case "${1:-}" in
  --dry-run)
    echo "Would fast-forward the dotfiles checkout and run apply."
    exec "$DOTFILES_ROOT/bin/apply" --dry-run
    ;;
  "") ;;
  -h|--help) echo "Usage: bin/update [--dry-run]"; exit 0 ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac

if [[ -n "$(git -C "$DOTFILES_ROOT" status --porcelain)" ]]; then
  echo "Refusing to update a checkout with local changes." >&2
  echo "Commit, stash, or otherwise resolve them, then rerun bin/update." >&2
  exit 1
fi

git -C "$DOTFILES_ROOT" pull --ff-only
exec "$DOTFILES_ROOT/bin/apply"

