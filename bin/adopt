#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DOTFILES_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
export DOTFILES_ROOT
source "$DOTFILES_ROOT/lib/paths.sh"
source "$DOTFILES_ROOT/lib/platform.sh"
source "$DOTFILES_ROOT/lib/files.sh"
source "$DOTFILES_ROOT/lib/desired.sh"

dotfiles_paths_init
platform_detect >/dev/null 2>&1 || true

target="${1:-}"
if [[ -z "$target" || "$target" == "--help" || "$target" == "-h" ]]; then
  echo "Usage: bin/adopt <configuration>"
  echo
  echo "Available configurations:"
  echo "  gh-shim"
  echo "  mise"
  echo "  nvim"
  if [[ "${OS:-}" == "macos" ]]; then
    echo "  starship"
    echo "  eza-theme"
    echo "  k9s-theme"
    echo "  alacritty"
    echo "  raycast-term"
    echo "  raycast-web"
    echo "  hushlogin"
    echo "  xcode-theme"
    echo "  codex-theme"
    echo "  claude-theme"
    echo "  capslock-helper"
    echo "  capslock-agent"
  fi
  echo
  echo "This first version only inspects ownership; it never changes files."
  [[ -n "$target" ]] && exit 0 || exit 2
fi

found=0
declare_managed_file() {
  local name="$1" source="$2" destination="$3" label="$4" status
  [[ "$name" == "$target" ]] || return 0
  found=1
  if [[ ! -e "$destination" && ! -L "$destination" ]]; then
    status="missing"
  elif is_managed "$destination"; then
    status="managed by this checkout"
  else
    status="existing and unmanaged"
  fi
  printf 'Configuration: %s\n' "$name"
  printf 'Source:        %s\n' "$source"
  printf 'Destination:   %s\n' "$(dotfiles_pretty_path "$destination")"
  printf 'Status:        %s\n' "$status"
  echo
  echo "Inspection only. No files were read, copied, moved, or replaced."
}
desired_managed_files

if [[ "$found" == "0" ]]; then
  echo "Unknown adopt target: $target" >&2
  exit 2
fi
