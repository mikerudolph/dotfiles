#!/usr/bin/env bash
set -euo pipefail

TEST_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(CDPATH= cd -- "$TEST_DIR/.." && pwd -P)"

for script in "$ROOT/setup" "$ROOT/bin/"* "$ROOT/lib/"*.sh "$ROOT/shell/"*.sh \
  "$ROOT/migrations/"*.sh "$ROOT/test/"*; do
  [[ -f "$script" ]] || continue
  bash -n "$script"
done

if command -v zsh >/dev/null 2>&1; then
  for script in "$ROOT/shell/common.sh" "$ROOT/shell/aliases.sh" \
    "$ROOT/shell/zsh.sh" "$ROOT/shell/zprofile.sh"; do
    zsh -n "$script"
  done
fi

for test_file in "$TEST_DIR"/*.test.sh; do
  [[ -f "$test_file" ]] || continue
  printf 'TEST %s\n' "$(basename -- "$test_file")"
  ROOT="$ROOT" bash "$test_file"
done

echo "All tests passed."
